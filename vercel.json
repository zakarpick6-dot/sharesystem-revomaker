{
  "cleanUrls": true,
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Content-Security-Policy", "value": "default-src 'self'; media-src 'self'; img-src 'self' data:; frame-ancestors 'none'" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" }
  ] }]
}
